# Copy to .env. Never commit credentials or pairing links.
APP_ORIGIN=http://localhost:3210
PORT=3210
MODEL_PROVIDER=openai
MODEL_ID=gpt-5.4
THINKING_LEVEL=medium
# Supply the provider's key through your shell or a private .env:
# OPENAI_API_KEY=...
# Or opt into an existing Pi login file:
# PI_AUTH=/absolute/path/to/auth.json
# STATE_DIR=/absolute/path/to/private/browser-lab-state
# Optional desktop, served by your own VNC server or SSH tunnel:
# VNC_HOST=127.0.0.1
# VNC_PORT=5900
# DESKTOP_PLATFORM=mac
