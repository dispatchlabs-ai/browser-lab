{
  "openapi": "3.1.0",
  "info": {
    "title": "Browser Lab alpha HTTP interface",
    "version": "0.1.0-alpha.1",
    "description": "Single-owner shipped UI interface. Host must match APP_ORIGIN. JSON bodies are limited to 64 KiB. Browser actions use the authenticated WebSocket bridge documented in architecture.md. This contract is not stable across alpha versions."
  },
  "servers": [
    {
      "url": "http://localhost:3210",
      "description": "Default; replace with configured APP_ORIGIN"
    }
  ],
  "security": [
    {
      "browserSession": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "description": "Minimal public liveness information.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "operationId": "status",
        "description": "Unauthenticated callers receive only authenticated:false. A valid session includes the configured model and desktop settings.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/pair": {
      "post": {
        "operationId": "redeemPair",
        "description": "Consumes one valid ten-minute token and sets browser_lab_session as HttpOnly, SameSite=Strict, Secure when HTTPS. Session lifetime is 24 hours.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Must equal APP_ORIGIN exactly."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pair"
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "description": "Revokes this browser session, clears its cookie, and terminates its active bridge and VNC sockets.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Must equal APP_ORIGIN exactly."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/lab/session": {
      "post": {
        "operationId": "openConversation",
        "description": "Creates a conversation or loads an existing one. All paired browsers share one owner and can access all conversations. Opening a bridge elsewhere replaces its existing connection.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Must equal APP_ORIGIN exactly."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionInput"
              }
            }
          }
        }
      }
    },
    "/api/lab/input": {
      "post": {
        "operationId": "submitMessage",
        "description": "Queues user input through Pi Durable. Supply a stable requestId for uncertain submission retries. This is not a guarantee that tool effects can safely be repeated.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Must equal APP_ORIGIN exactly."
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Submission"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          }
        }
      }
    },
    "/api/lab/stop": {
      "post": {
        "operationId": "stopRun",
        "description": "Requests cancellation. Already delivered browser/desktop input cannot be undone.",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Must equal APP_ORIGIN exactly."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request rejected; error is a code or explanatory message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Stop"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "browser_lab_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      },
      "OK": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": ["ok"]
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "const": "browser-lab"
          },
          "version": {
            "type": "string"
          }
        },
        "required": ["ok", "service", "version"]
      },
      "Status": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "thinkingLevel": {
            "type": "string"
          },
          "desktopEnabled": {
            "type": "boolean"
          },
          "desktopPlatform": {
            "enum": ["mac", "linux"]
          }
        },
        "required": ["authenticated"]
      },
      "Pair": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["token"]
      },
      "SessionInput": {
        "type": "object",
        "properties": {
          "conversationId": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "description": "Existing numeric conversation ID; omit to create."
              }
            ]
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "thinkingLevel": {
            "type": "string"
          }
        },
        "required": ["conversationId", "model", "provider", "thinkingLevel"]
      },
      "Input": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "description": "Caller-generated stable ID; reuse for uncertain submission retries."
          }
        },
        "required": ["conversationId", "text"]
      },
      "Submission": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["submissionId"]
      },
      "Stop": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["conversationId"]
      }
    }
  }
}
